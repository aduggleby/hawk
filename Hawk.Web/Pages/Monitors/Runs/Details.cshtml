@page "{monitorId:guid}/{runId:guid}"
@model Hawk.Web.Pages.Monitors.Runs.DetailsModel
@{
    ViewData["Title"] = "Run diagnostics";
    var state = string.IsNullOrWhiteSpace(Model.Run?.State) ? "completed" : Model.Run!.State;
    var isHeartbeat = Model.Monitor?.Type == Hawk.Web.Data.Monitoring.MonitorType.Heartbeat;
    var isDone = string.Equals(state, "completed", StringComparison.OrdinalIgnoreCase);
    var word = !isDone ? state.ToUpperInvariant() : Model.Run!.Success ? "OK" : "FAIL";
    var wordClass = !isDone ? "idle" : Model.Run!.Success ? "up" : "down";
    static string UtcFallback(DateTimeOffset value) => value.UtcDateTime.ToString("g") + " UTC";
    static string UtcDetailedFallback(DateTimeOffset value) => value.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss 'UTC'");
}

@if (Model.Monitor is null || Model.Run is null)
{
    <div class="hawk-card border-[color:var(--text-primary)] border-dashed">
        <div class="text-sm">Run not found.</div>
    </div>
    return;
}

<div class="hawk-d-head">
    <div class="min-w-0">
        <nav class="text-sm text-zinc-500 mb-2" aria-label="Breadcrumb">
            <a asp-page="/Monitors/Index">Monitors</a>
            <span class="mx-1">/</span>
            <a asp-page="/Monitors/Details" asp-route-id="@Model.Monitor.Id">@Model.Monitor.Name</a>
            <span class="mx-1">/</span>
            <span>Run</span>
        </nav>
        <h1 class="text-2xl font-semibold tracking-tight mb-1">Run diagnostics</h1>
        <div class="text-sm text-[color:var(--text-secondary)]">
            <a class="underline decoration-dotted underline-offset-2 hover:no-underline"
               asp-page="/Monitors/Details"
               asp-route-id="@Model.Monitor.Id">@Model.Monitor.Name</a>
            <span class="mx-2 text-[color:var(--text-muted)]">·</span>
            <time data-utc="@Model.Run.StartedAt.ToString("O")" data-utc-format="short">@UtcFallback(Model.Run.StartedAt)</time>
        </div>
    </div>
    <div class="flex flex-wrap items-center gap-2">
        @if (!isHeartbeat)
        {
            <form method="post" asp-page="/Monitors/Details" asp-page-handler="RunNow" asp-route-id="@Model.Monitor.Id">
                <button class="hawk-btn hawk-btn-primary" type="submit">Run again</button>
            </form>
        }
        <a class="hawk-btn hawk-btn-ghost" asp-page="/Monitors/Details" asp-route-id="@Model.Monitor.Id">Back to monitor</a>
    </div>
</div>

<section class="hawk-d-lead" data-testid="status-lead" aria-label="Run result">
    <span class="hawk-d-word @wordClass condensed" data-testid="run-result">@word</span>
    <span class="hawk-d-since num">
        started
        <b><time data-utc="@Model.Run.StartedAt.ToString("O")" data-utc-format="detailed">@UtcDetailedFallback(Model.Run.StartedAt)</time></b>
    </span>
</section>

@section Scripts {
    <script>
        (() => {
            const state = "@state";
            if (state === "completed") return;

            const timeoutSeconds = Number("@Model.Monitor.TimeoutSeconds");
            const maxSeconds = Number.isFinite(timeoutSeconds) && timeoutSeconds > 0 ? timeoutSeconds : 300;

            const key = `hawk:run-refresh-start:@Model.Run.Id`;
            const existing = window.sessionStorage.getItem(key);
            const startedAtMs = existing ? Number(existing) : Date.now();
            if (!existing) window.sessionStorage.setItem(key, String(startedAtMs));

            const getDelayMs = (elapsedSeconds) => {
                if (maxSeconds <= 30) return 1000;
                return elapsedSeconds < 30 ? 1000 : 15000;
            };

            const elapsed = (Date.now() - startedAtMs) / 1000.0;
            if (elapsed >= maxSeconds) return;
            window.setTimeout(() => window.location.reload(), getDelayMs(elapsed));
        })();
    </script>
}

<div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
    <div class="lg:col-span-4 space-y-4">
        <div class="hawk-card">
            <div class="font-semibold mb-3">Run metadata</div>
            <dl class="hawk-r-kv">
                <dt>Result</dt>
                <dd>
                    @if (!isDone)
                    {
                        <span class="hawk-badge hawk-badge-warning">@state.ToUpperInvariant()</span>
                    }
                    else if (Model.Run.Success)
                    {
                        <span class="hawk-badge hawk-badge-success">OK</span>
                    }
                    else
                    {
                        <span class="hawk-badge hawk-badge-danger">FAIL</span>
                    }
                </dd>
                <dt>Reason</dt>
                <dd>@(Model.Run.Reason ?? "-")</dd>
                <dt>Started</dt>
                <dd><time data-utc="@Model.Run.StartedAt.ToString("O")" data-utc-format="detailed">@UtcDetailedFallback(Model.Run.StartedAt)</time></dd>
                <dt>Finished</dt>
                <dd><time data-utc="@Model.Run.FinishedAt.ToString("O")" data-utc-format="detailed">@UtcDetailedFallback(Model.Run.FinishedAt)</time></dd>
                <dt>Duration</dt>
                <dd>@Model.Run.DurationMs ms</dd>
                <dt>@(isHeartbeat ? "Response" : "HTTP status")</dt>
                <dd>@(Model.Run.StatusCode?.ToString() ?? "NO_RESPONSE")</dd>
                <dt>Alert</dt>
                <dd>@Model.AlertStatus</dd>
                <dt>Error</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Run.ErrorMessage) ? "-" : Model.Run.ErrorMessage)</dd>
            </dl>
        </div>
    </div>

    <div class="lg:col-span-8 space-y-4">
        <div class="hawk-card">
            <div class="font-semibold mb-3">@(isHeartbeat ? "Ping" : "Request")</div>
            <dl class="hawk-r-kv">
                <dt>@(isHeartbeat ? "Path" : "URL")</dt><dd>@(Model.Run.RequestUrl ?? "-")</dd>
                <dt>Method</dt><dd>@(Model.Run.RequestMethod ?? "-")</dd>
                <dt>Content-Type</dt><dd>@(Model.Run.RequestContentType ?? "-")</dd>
                @if (!isHeartbeat)
                {
                    <dt>Timeout</dt><dd>@(Model.Run.RequestTimeoutMs?.ToString() ?? "-") ms</dd>
                }
            </dl>
            <div class="hawk-r-label">@(isHeartbeat ? "Source (client IP, User-Agent)" : "Headers")</div>
            <pre class="hawk-r-pre">@((string.IsNullOrWhiteSpace(Model.Run.RequestHeadersJson) ? "{}" : Model.Run.RequestHeadersJson))</pre>
            @if (!isHeartbeat)
            {
                <div class="hawk-r-label">Body snippet</div>
                <pre class="hawk-r-pre">@(string.IsNullOrWhiteSpace(Model.Run.RequestBodySnippet) ? "-" : Model.Run.RequestBodySnippet)</pre>
            }
        </div>

        @if (!isHeartbeat)
        {
            <div class="hawk-card">
                <div class="font-semibold mb-3">Response</div>
                <dl class="hawk-r-kv">
                    <dt>Content-Type</dt><dd>@(Model.Run.ResponseContentType ?? "-")</dd>
                    <dt>Content-Length</dt><dd>@(Model.Run.ResponseContentLength?.ToString() ?? "-")</dd>
                </dl>
                <div class="hawk-r-label">Headers</div>
                <pre class="hawk-r-pre">@Model.FormatJson(Model.Run.ResponseHeadersJson, "{}")</pre>
                <div class="hawk-r-label">Response snippet</div>
                @{
                    var snippet = string.IsNullOrWhiteSpace(Model.Run.ResponseSnippet) ? "-" : Model.Run.ResponseSnippet!;
                    const int previewLimit = 600;
                    var hasMore = snippet.Length > previewLimit;
                    var preview = hasMore ? snippet[..previewLimit] + "..." : snippet;
                }
                <pre class="hawk-r-pre">@preview</pre>
                @if (hasMore)
                {
                    <details class="mt-2">
                        <summary class="cursor-pointer select-none text-[color:var(--text-secondary)]">Show full response snippet</summary>
                        <pre class="hawk-r-pre" style="margin-top: 8px">@snippet</pre>
                    </details>
                }
                <div class="hawk-r-label">Match results</div>
                <pre class="hawk-r-pre">@((string.IsNullOrWhiteSpace(Model.Run.MatchResultsJson) ? "[]" : Model.Run.MatchResultsJson))</pre>
            </div>
        }
    </div>
</div>
