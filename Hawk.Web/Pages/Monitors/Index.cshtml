@page
@* <summary>Monitors overview (Tower board): headline, Attention strip, group rail and rows with 24 h strips.</summary> *@
@model Hawk.Web.Pages.Monitors.IndexModel
@using Hawk.Web.Services.Monitoring
@{
    ViewData["Title"] = "Monitors";
    var board = Model.Board;
    var now = DateTimeOffset.UtcNow;
    static string UtcFallback(DateTimeOffset value) => value.UtcDateTime.ToString("g") + " UTC";
    static string StatusClass(BoardRow r) =>
        r.Failing ? "down" : r.State == MonitorState.Disabled ? "disabled" : r.State == MonitorState.Paused ? "paused"
            : r.Overdue ? "overdue" : r.Pending ? "pending" : "up";
}

<div class="hawk-board-layout">
@if (board.Total > 0)
{
    <nav class="hawk-rail" aria-label="Groups">
        <h2 class="hawk-rail-title">Groups</h2>
        <ul class="hawk-rail-list">
            @foreach (var g in board.Groups)
            {
                <li>
                    <a class="hawk-rail-item" href="#@g.Anchor">
                        <span class="hawk-rail-name">@(g.Name ?? "Ungrouped")</span>
                        @if (g.DownCount > 0)
                        {
                            <span class="hawk-rail-down" title="@g.DownCount down"><i class="hawk-sq down"></i>@g.DownCount<span class="sr-only"> down</span></span>
                        }
                        <span class="hawk-rail-count">@g.Rows.Count</span>
                    </a>
                </li>
            }
        </ul>
    </nav>
}

<div class="hawk-board-main">
<div class="hawk-board-head">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">Monitors</h1>
        <p class="hawk-board-headline" data-testid="board-headline">@board.Headline</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
        <div id="monitors-actions-default" class="flex flex-wrap items-center gap-2">
            @if (User.IsInRole("Admin"))
            {
                <a class="hawk-btn hawk-btn-ghost" asp-page="/Admin/Import/StatusCake">Import StatusCake</a>
            }
            <form method="post" asp-page-handler="PauseAll">
                <button class="hawk-btn hawk-btn-ghost" type="submit">Pause all</button>
            </form>
            <form method="post" asp-page-handler="ResumeAll">
                <button class="hawk-btn hawk-btn-ghost" type="submit">Resume all</button>
            </form>
            <a class="hawk-btn hawk-btn-primary" asp-page="/Monitors/Create">New monitor</a>
        </div>

        <div id="monitors-actions-selected" class="flex flex-wrap items-center gap-2" hidden>
            <div class="text-xs select-none mr-1" style="color: var(--muted)">
                Selected: <span id="monitors-selected-count">0</span>
            </div>
            <button class="hawk-btn hawk-btn-ghost" type="submit" form="batch-form" name="BatchAction" value="run">Run now</button>
            <button class="hawk-btn hawk-btn-ghost" type="submit" form="batch-form" name="BatchAction" value="pause">Pause</button>
            <button class="hawk-btn hawk-btn-ghost" type="submit" form="batch-form" name="BatchAction" value="resume">Resume</button>
            <button class="hawk-btn hawk-btn-ghost" type="button" id="monitors-uncheck-all">Uncheck all</button>
        </div>
    </div>
</div>

@if (board.Total == 0)
{
    <div class="hawk-card">
        <div class="text-sm" style="color: var(--muted)">No monitors yet. Create your first one.</div>
    </div>
}
else
{
    @if (board.Attention.Count != 0)
    {
        <section class="hawk-attention" aria-labelledby="attention-title" data-testid="attention">
            <h2 id="attention-title">Attention</h2>
            <div class="hawk-attention-list">
                @foreach (var a in board.Attention)
                {
                    <a class="hawk-att" asp-page="/Monitors/Details" asp-route-id="@a.Monitor.Id">
                        <span class="hawk-att-t">
                            <span class="hawk-att-nm">@a.Monitor.Name</span>
                            <span class="hawk-att-kind">@(a.Monitor.Type == Hawk.Web.Data.Monitoring.MonitorType.Heartbeat ? "Heartbeat" : "HTTP")@(a.State == MonitorState.Active ? "" : $" \u00b7 {a.State}")</span>
                        </span>
                        <span class="hawk-att-reason">@a.Reason</span>
                        <span class="hawk-att-meta">
                            <b>Down @BoardHeadline.Duration(now - a.Since)</b>
                            since <time data-utc="@a.Since.ToString("O")" data-utc-format="short">@UtcFallback(a.Since)</time>
                            @if (a.StatusCode is { } code)
                            {
                                <span>&middot; last status @code</span>
                            }
                        </span>
                    </a>
                }
            </div>
        </section>
    }

    <form method="post" asp-page-handler="Batch" id="batch-form">
        @foreach (var grp in board.Groups)
        {
            <section class="hawk-bgroup" id="@grp.Anchor">
                <div class="hawk-bgroup-head">
                    <input class="hawk-check" type="checkbox" data-group-select="@grp.Anchor" aria-label="Select all in @(grp.Name ?? "Ungrouped")" />
                    <h2>@(grp.Name ?? "Ungrouped")</h2>
                    <div class="hawk-bgroup-count">
                        @grp.Rows.Count monitor(s)@if (grp.DownCount > 0)
                        {
                            <span class="hawk-bgroup-down"> &middot; @grp.DownCount down</span>
                        }
                    </div>
                    @if (grp.Name is not null)
                    {
                        <div class="hawk-bgroup-actions">
                            <button class="hawk-btn hawk-btn-ghost" type="submit" formaction="?handler=GroupRun" name="Group" value="@grp.Name">Run</button>
                            <button class="hawk-btn hawk-btn-ghost" type="submit" formaction="?handler=GroupPause" name="Group" value="@grp.Name">Pause</button>
                            <button class="hawk-btn hawk-btn-ghost" type="submit" formaction="?handler=GroupResume" name="Group" value="@grp.Name">Resume</button>
                            <button class="hawk-btn hawk-btn-ghost" type="button" data-rename-group="@grp.Name">Rename</button>
                        </div>
                    }
                </div>
                <div class="hawk-brows" role="table" aria-label="@(grp.Name ?? "Ungrouped") monitors">
                    <div class="hawk-brow hawk-brow-hdr" role="row">
                        <span role="columnheader" class="hawk-c-sel"><span class="sr-only">Select</span></span>
                        <span role="columnheader" class="hawk-c-st">Status</span>
                        <span role="columnheader" class="hawk-c-nm">Name</span>
                        <span role="columnheader" class="hawk-c-sc">Last 24 hours</span>
                        <span role="columnheader" class="hawk-c-lat">Response</span>
                        <span role="columnheader" class="hawk-c-when">Last run</span>
                    </div>
                    @foreach (var r in grp.Rows)
                    {
                        var m = r.Monitor;
                        var cls = StatusClass(r);
                        <div class="hawk-brow @(r.Failing ? "is-down" : "") @(r.State != MonitorState.Active ? "is-off" : "")" role="row">
                            <span role="cell" class="hawk-c-sel">
                                <input class="hawk-check" type="checkbox" name="SelectedMonitorIds" value="@m.Id" data-group="@grp.Anchor" aria-label="Select @m.Name" />
                            </span>
                            <span role="cell" class="hawk-c-st" data-status="@cls"><i class="hawk-sq @cls"></i>@r.StatusLabel</span>
                            <span role="cell" class="hawk-c-nm">
                                <a asp-page="/Monitors/Details" asp-route-id="@m.Id">@m.Name</a>
                                <span class="hawk-kind">@(m.Type == Hawk.Web.Data.Monitoring.MonitorType.Heartbeat ? "Heartbeat" : "HTTP")</span>
                            </span>
                            <span role="cell" class="hawk-c-sc"><partial name="_StatusStrip" model="r.Strip" /></span>
                            <span role="cell" class="hawk-c-lat">@(r.LastMs is { } ms ? $"{ms} ms" : "-")</span>
                            <span role="cell" class="hawk-c-when">
                                @if (m.LastRunAt is { } lastRunAt)
                                {
                                    <time data-utc="@lastRunAt.ToString("O")" data-utc-format="short">@UtcFallback(lastRunAt)</time>
                                }
                                else
                                {
                                    @:-
                                }
                            </span>
                        </div>
                    }
                </div>
            </section>
        }
    </form>
    <div class="hawk-legend">
        <span>Strip: last 24 hours, bar height = response time</span>
        <span><i class="hawk-sq down"></i> failed check</span>
        <span><i class="hawk-sq empty"></i> no data</span>
    </div>

    @* Rename lives outside batch-form: nested forms are not allowed. *@
    <dialog id="group-rename-dialog" class="hawk-card" data-groups="@System.Text.Json.JsonSerializer.Serialize(board.Groups.Where(g => g.Name is not null).Select(g => new { name = g.Name, count = g.Rows.Count }))">
        <form method="post" asp-page-handler="GroupRename" id="group-rename-form" class="space-y-3">
            <input type="hidden" name="Group" id="group-rename-old" />
            <label class="hawk-label" for="group-rename-new">New group name</label>
            <input class="hawk-input" id="group-rename-new" name="NewGroupName" maxlength="100" autocomplete="off" />
            <div class="flex items-center gap-2">
                <button class="hawk-btn hawk-btn-primary" type="submit">Rename</button>
                <button class="hawk-btn hawk-btn-ghost" type="button" id="group-rename-cancel">Cancel</button>
            </div>
        </form>
    </dialog>
}
</div>
</div>

@section Scripts {
    <script>
        (() => {
            const defaultActions = document.getElementById("monitors-actions-default");
            const selectedActions = document.getElementById("monitors-actions-selected");
            const selectedCount = document.getElementById("monitors-selected-count");
            const uncheckAll = document.getElementById("monitors-uncheck-all");

            const boxes = Array.from(document.querySelectorAll('input[name="SelectedMonitorIds"]'));
            if (!defaultActions || !selectedActions || boxes.length === 0) return;
            const headers = Array.from(document.querySelectorAll("input[data-group-select]"));

            const sync = () => {
                // Count each monitor once (ids are unique per row).
                const checked = new Set(boxes.filter(b => b.checked).map(b => b.value)).size;
                defaultActions.hidden = checked > 0;
                selectedActions.hidden = checked === 0;
                if (selectedCount) selectedCount.textContent = String(checked);
                for (const h of headers) {
                    const own = boxes.filter(b => b.dataset.group === h.dataset.groupSelect);
                    h.checked = own.length > 0 && own.every(b => b.checked);
                }
            };

            for (const b of boxes) {
                b.addEventListener("change", () => {
                    for (const twin of boxes) if (twin.value === b.value) twin.checked = b.checked;
                    sync();
                });
            }
            for (const h of headers) {
                h.addEventListener("change", () => {
                    for (const b of boxes) {
                        if (b.dataset.group !== h.dataset.groupSelect) continue;
                        for (const twin of boxes) if (twin.value === b.value) twin.checked = h.checked;
                    }
                    sync();
                });
            }
            if (uncheckAll) {
                uncheckAll.addEventListener("click", () => {
                    for (const b of boxes) b.checked = false;
                    sync();
                });
            }

            const dialog = document.getElementById("group-rename-dialog");
            if (dialog) {
                const form = document.getElementById("group-rename-form");
                const oldInput = document.getElementById("group-rename-old");
                const newInput = document.getElementById("group-rename-new");
                let groups = [];
                try { groups = JSON.parse(dialog.dataset.groups || "[]"); } catch { groups = []; }
                for (const btn of document.querySelectorAll("[data-rename-group]")) {
                    btn.addEventListener("click", () => {
                        oldInput.value = btn.dataset.renameGroup;
                        newInput.value = btn.dataset.renameGroup;
                        dialog.showModal();
                        newInput.select();
                    });
                }
                document.getElementById("group-rename-cancel").addEventListener("click", () => dialog.close());
                form.addEventListener("submit", e => {
                    const from = oldInput.value.toLowerCase();
                    const to = newInput.value.trim().toLowerCase();
                    const target = groups.find(g => g.name.toLowerCase() === to && to !== from);
                    if (target && !confirm("Merge into " + target.name + " (" + target.count + " monitors)?")) e.preventDefault();
                });
            }

            sync();
        })();
    </script>
}
