@page "{id:guid}"
@* <summary>Monitor details and run history.</summary> *@
@model Hawk.Web.Pages.Monitors.DetailsModel
@{
    ViewData["Title"] = Model.Monitor?.Name ?? "Monitor";
    var isHeartbeat = Model.Monitor?.Type == Hawk.Web.Data.Monitoring.MonitorType.Heartbeat;
    static string UtcFallback(DateTimeOffset value) => value.UtcDateTime.ToString("g") + " UTC";
    Microsoft.AspNetCore.Html.IHtmlContent StateTime(DateTimeOffset? value, string? id) => value is { } v
        ? Html.Raw($"<time{(id is null ? "" : $" id=\"{id}\"")} data-utc=\"{v:O}\" data-utc-format=\"short\">{UtcFallback(v)}</time>")
        : Html.Raw("&mdash;");
}

@if (Model.Monitor is null)
{
    <div class="hawk-card border-[color:var(--text-primary)] border-dashed">
        <div class="text-sm">Monitor not found.</div>
    </div>
    return;
}

@{
    var indexUrl = Url.Page("/Monitors/Index");
    var groupName = Model.Monitor.GroupName;
    var groupUrl = indexUrl + "#" + Hawk.Web.Services.Monitoring.MonitorGroups.Anchor(groupName);
    var lead = Model.Lead!;
    var history = Model.History!;
    var leadClass = lead.Kind switch
    {
        Hawk.Web.Services.Monitoring.LeadKind.Up => "up",
        Hawk.Web.Services.Monitoring.LeadKind.Down => "down",
        Hawk.Web.Services.Monitoring.LeadKind.Overdue => "warn",
        _ => "idle",
    };
}

<div class="hawk-d-head">
    <div class="min-w-0">
        <nav class="text-sm text-zinc-500 mb-2" aria-label="Breadcrumb">
            <a href="@indexUrl">Monitors</a>
            @if (groupName is not null)
            {
                <span class="mx-1">/</span>
                <a href="@groupUrl">@groupName</a>
            }
            <span class="mx-1">/</span>
            <span>@Model.Monitor.Name</span>
        </nav>
        <h1 class="text-2xl font-semibold tracking-tight mb-1">
            @Model.Monitor.Name
            @if (groupName is not null)
            {
                <a href="@groupUrl" class="hawk-badge ml-2 align-middle no-underline">@groupName</a>
            }
        </h1>
        <div class="text-sm text-[color:var(--text-secondary)] font-mono break-all">
            @if (isHeartbeat)
            {
                <span class="rounded-lg border border-[color:var(--border-primary)] bg-[color:var(--bg-secondary)] px-2 py-1 text-xs text-[color:var(--text-primary)]">HEARTBEAT</span>
                <span class="mx-2 text-[color:var(--text-muted)]">·</span>
                <span>Expected every @Hawk.Web.Services.Monitoring.MonitorIntervals.FormatDuration(Model.Monitor.IntervalSeconds) + @Hawk.Web.Services.Monitoring.MonitorIntervals.FormatDuration(Model.Monitor.HeartbeatGraceSeconds) grace</span>
            }
            else
            {
                <span class="rounded-lg border border-[color:var(--border-primary)] bg-[color:var(--bg-secondary)] px-2 py-1 text-xs text-[color:var(--text-primary)]">@Model.Monitor.Method</span>
                <span class="mx-2 text-[color:var(--text-muted)]">·</span>
                <span>@Model.Monitor.Url</span>
            }
        </div>
    </div>
    <div class="flex flex-wrap items-center gap-2">
        @if (!isHeartbeat)
        {
            <form id="run-now-form" method="post" asp-page-handler="RunNow">
                <button class="hawk-btn hawk-btn-primary" type="submit">Run now</button>
            </form>
        }
        <a class="hawk-btn hawk-btn-ghost" asp-page="/Monitors/Edit" asp-route-id="@Model.Monitor.Id">Edit</a>
        <a class="hawk-btn hawk-btn-ghost" asp-page-handler="Export" asp-route-id="@Model.Monitor.Id">Export JSON</a>
    </div>
</div>

<section class="hawk-d-lead" data-testid="status-lead" aria-label="Current status">
    <span class="hawk-d-word @leadClass condensed" data-testid="status-word">@lead.Word</span>
    <span class="hawk-d-since num">
        @lead.Caption
        @if (lead.Time is { } leadTime)
        {
            <b><time data-testid="status-since" data-utc="@leadTime.ToString("O")" data-utc-format="detailed">@UtcFallback(leadTime)</time></b>
        }
    </span>
</section>

<div class="hawk-d-figures num">
    <dl data-testid="uptime-figures">
        <div><dt>24 h</dt><dd data-testid="uptime-24h">@Hawk.Web.Services.Monitoring.MonitorHistoryService.FormatPercent(history.Uptime.Last24h)</dd></div>
        <div><dt>7 d</dt><dd data-testid="uptime-7d">@Hawk.Web.Services.Monitoring.MonitorHistoryService.FormatPercent(history.Uptime.Last7d)</dd></div>
        <div><dt>30 d</dt><dd data-testid="uptime-30d">@Hawk.Web.Services.Monitoring.MonitorHistoryService.FormatPercent(history.Uptime.Last30d)</dd></div>
    </dl>
    <dl class="hawk-d-state" data-testid="check-state">
        @if (isHeartbeat)
        {
            <div><dt>Last ping</dt><dd>@StateTime(Model.Monitor.LastPingAt, "last-ping")</dd></div>
            <div><dt>Due by</dt><dd>@StateTime(Model.Monitor.NextRunAt, null)</dd></div>
        }
        else
        {
            <div><dt>Last check</dt><dd>@StateTime(Model.Monitor.LastRunAt, null)</dd></div>
            <div><dt>Next</dt><dd class="muted">@StateTime(Model.Monitor.NextRunAt, null)</dd></div>
        }
    </dl>
</div>

@section Scripts {
    <script>
        (() => {
            // Heartbeat periods can be days; refresh at least every 30s so pings and misses show up.
            const intervalSeconds = Math.min(@Model.Monitor.IntervalSeconds, @(isHeartbeat ? 30 : int.MaxValue));
            if (!Number.isFinite(intervalSeconds) || intervalSeconds < 1) return;

            const refreshMs = intervalSeconds * 1000;
            let timer = window.setTimeout(() => {
                window.location.reload();
            }, refreshMs);

            const copyBtn = document.getElementById("ping-url-copy");
            const pingUrl = document.getElementById("ping-url");
            if (copyBtn && pingUrl) {
                copyBtn.addEventListener("click", async () => {
                    try {
                        await navigator.clipboard.writeText(pingUrl.value);
                        copyBtn.textContent = "Copied";
                    } catch {
                        pingUrl.select();
                        document.execCommand("copy");
                        copyBtn.textContent = "Copied";
                    }
                });
            }

            // Keep the page update cadence aligned with the monitor interval.
            const runNowForm = document.getElementById("run-now-form");
            if (runNowForm) {
                runNowForm.addEventListener("submit", () => {
                    window.clearTimeout(timer);
                });
            }
        })();
    </script>
}

@if (isHeartbeat)
{
    <div class="hawk-card mb-4" data-testid="ping-timeline">
        <div class="font-semibold mb-3">Pings <span class="hawk-d-sub">last 24 hours</span></div>
        @if (history.Strip.Cells.All(c => c.State == Hawk.Web.Services.Monitoring.StripCellState.Empty))
        {
            <div class="hawk-d-empty">No data yet</div>
        }
        else
        {
            <partial name="_StatusStrip" model="history.Strip" />
            <div class="hawk-d-axis"><span>24 h ago</span><span>12 h ago</span><span>now</span></div>
        }
    </div>
}
else
{
    <div class="hawk-card mb-4" data-testid="response-chart">
        <div class="font-semibold mb-3">Response time <span class="hawk-d-sub">last 24 hours, one point per 15 minutes</span></div>
        @if (history.Chart is not { } chart)
        {
            <div class="hawk-d-empty">No data yet</div>
        }
        else
        {
            <svg class="hawk-d-chart" viewBox="0 0 @chart.Width @chart.Height" role="img" aria-label="@chart.AriaLabel">
                @foreach (var line in chart.Grid)
                {
                    <line class="gl" x1="0" x2="@chart.Width" y1="@line.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)" y2="@line.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                }
                @foreach (var pt in chart.Points.Where(p => p.Failed))
                {
                    <rect class="band" x="@((pt.X - chart.CellWidth / 2).ToString(System.Globalization.CultureInfo.InvariantCulture))" y="0" width="@chart.CellWidth.ToString(System.Globalization.CultureInfo.InvariantCulture)" height="@chart.Height" />
                }
                @foreach (var d in chart.Paths)
                {
                    <path class="ln" d="@d" />
                }
                @foreach (var pt in chart.Points)
                {
                    var tip = $"{pt.Cell.Start.UtcDateTime:HH:mm} UTC: {pt.Cell.Runs} {(pt.Cell.Runs == 1 ? "run" : "runs")}, {pt.Cell.Failures} failed, avg {pt.Cell.AverageMs} ms";
                    <circle class="@(pt.Failed ? "pt fail" : pt.Isolated ? "pt" : "hit")" cx="@pt.X.ToString(System.Globalization.CultureInfo.InvariantCulture)" cy="@pt.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)" r="@(pt.Failed || pt.Isolated ? 3 : 5)"><title>@tip</title></circle>
                }
                @* Labels come last so they paint over the failure bands (halo in hawk-details.css). *@
                @foreach (var line in chart.Grid)
                {
                    @:<text x="@chart.Width" y="@((line.Y - 3).ToString(System.Globalization.CultureInfo.InvariantCulture))" text-anchor="end">@line.Ms ms</text>
                }
            </svg>
            <div class="hawk-d-axis"><span>24 h ago</span><span>12 h ago</span><span>now</span></div>
        }
    </div>
}

<div class="hawk-card mb-4" data-testid="uptime-days">
    <div class="font-semibold mb-3">Uptime <span class="hawk-d-sub">last 90 days, one cell per UTC day</span></div>
    @if (!history.HasDayData)
    {
        <div class="hawk-d-empty">No data yet</div>
    }
    else
    {
        var belowTarget = history.Days.Count(d => d.State is Hawk.Web.Services.Monitoring.DayState.DownTint or Hawk.Web.Services.Monitoring.DayState.Down);
        <div class="hawk-d-days" role="img" aria-label="Uptime per day, last 90 days: @history.Days.Count(d => d.Runs > 0) days with data, @belowTarget below 99%">
            @foreach (var day in history.Days)
            {
                var cls = day.State switch
                {
                    Hawk.Web.Services.Monitoring.DayState.Up => "up",
                    Hawk.Web.Services.Monitoring.DayState.UpDim => "dim",
                    Hawk.Web.Services.Monitoring.DayState.DownTint => "tint",
                    Hawk.Web.Services.Monitoring.DayState.Down => "down",
                    _ => "",
                };
                var title = day.Runs == 0
                    ? $"{day.Day:yyyy-MM-dd}: no data"
                    : $"{day.Day:yyyy-MM-dd}: {Hawk.Web.Services.Monitoring.MonitorHistoryService.FormatPercent(day.UptimePercent)} ({day.Failures} of {day.Runs} runs failed)";
                <i class="@cls" data-day="@day.Day.ToString("yyyy-MM-dd")" title="@title" aria-hidden="true"></i>
            }
        </div>
        <div class="hawk-d-legend">
            <span><i class="up"></i>100%</span>
            <span><i class="dim"></i>99% to under 100%</span>
            <span><i class="tint"></i>95% to under 99%</span>
            <span><i class="down"></i>under 95%</span>
            <span><i></i>no data</span>
        </div>
    }
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
    <div class="lg:col-span-5 space-y-4">
        @if (isHeartbeat && Model.PingUrl is { } pingUrl)
        {
            <div class="hawk-card" data-testid="ping-card">
                <div class="font-semibold mb-3">Ping URL</div>
                <div class="flex items-center gap-2">
                    <input id="ping-url" class="hawk-input font-mono text-xs" type="text" readonly value="@pingUrl" aria-label="Ping URL" />
                    <button id="ping-url-copy" class="hawk-btn hawk-btn-ghost" type="button">Copy</button>
                </div>
                <p class="text-xs text-[color:var(--text-secondary)] mt-3">GET, HEAD or POST this URL from your job when it succeeds. Keep it secret: anyone with the URL can send pings.</p>
                <pre id="ping-curl" class="mt-3 p-3 bg-[color:var(--bg-secondary)] border border-[color:var(--border-primary)] overflow-x-auto whitespace-pre-wrap break-all text-xs font-mono">curl -fsS -m 10 --retry 3 @pingUrl</pre>
            </div>
        }
        <div class="hawk-card hawk-d-config">
            <div class="font-semibold mb-3">Config</div>
            <dl class="grid grid-cols-12 text-sm">
                <dt class="col-span-4 text-[color:var(--text-secondary)]">Status</dt>
                <dd class="col-span-8">
                    @if (!Model.Monitor.Enabled)
                    {
                        <span class="hawk-badge hawk-badge-danger">Disabled</span>
                    }
                    else if (Model.Monitor.IsPaused)
                    {
                        <span class="hawk-badge hawk-badge-warning">Paused</span>
                    }
                    else
                    {
                        <span class="hawk-badge hawk-badge-success">Enabled</span>
                    }
                </dd>
                @if (isHeartbeat)
                {
                    <dt class="col-span-4 text-[color:var(--text-secondary)]">Expected every</dt>
                    <dd class="col-span-8">@Hawk.Web.Services.Monitoring.MonitorIntervals.FormatDuration(Model.Monitor.IntervalSeconds)</dd>
                    <dt class="col-span-4 text-[color:var(--text-secondary)]">Grace</dt>
                    <dd class="col-span-8">@Hawk.Web.Services.Monitoring.MonitorIntervals.FormatDuration(Model.Monitor.HeartbeatGraceSeconds)</dd>
                }
                else
                {
                    <dt class="col-span-4 text-[color:var(--text-secondary)]">Interval</dt>
                    <dd class="col-span-8">@((Model.Monitor.IntervalSeconds < 60) ? $"{Model.Monitor.IntervalSeconds}s" : $"{Model.Monitor.IntervalSeconds / 60}m")</dd>
                    <dt class="col-span-4 text-[color:var(--text-secondary)]">Timeout</dt>
                    <dd class="col-span-8">@Model.Monitor.TimeoutSeconds s</dd>
                    <dt class="col-span-4 text-[color:var(--text-secondary)]">Allowed status</dt>
                    @if (string.IsNullOrWhiteSpace(Model.Monitor.AllowedStatusCodes))
                    {
                        <dd class="col-span-8"><span class="default">2xx only</span></dd>
                    }
                    else
                    {
                        <dd class="col-span-8 mono break-words">2xx + @Model.Monitor.AllowedStatusCodes</dd>
                    }
                    <dt class="col-span-4 text-[color:var(--text-secondary)]">Follow redirects</dt>
                    <dd class="col-span-8">@(Model.Monitor.FollowRedirects ? "Yes" : "No")</dd>
                }
                <dt class="col-span-4 text-[color:var(--text-secondary)]">Alert after</dt>
                <dd class="col-span-8">@Model.Monitor.AlertAfterConsecutiveFailures consecutive @(Model.Monitor.AlertAfterConsecutiveFailures == 1 ? "failure" : "failures")</dd>
                <dt class="col-span-4 text-[color:var(--text-secondary)]">Alert email</dt>
                @if (!string.IsNullOrWhiteSpace(Model.Monitor.AlertEmailOverride))
                {
                    <dd class="col-span-8 mono break-words">@Model.Monitor.AlertEmailOverride</dd>
                }
                else
                {
                    <dd class="col-span-8"><span class="default">Default recipient</span></dd>
                }
                <dt class="col-span-4 text-[color:var(--text-secondary)]">Run retention</dt>
                @if (Model.Monitor.RunRetentionDays is > 0)
                {
                    <dd class="col-span-8">@Model.Monitor.RunRetentionDays days (override)</dd>
                }
                else
                {
                    <dd class="col-span-8"><span class="default">Account/default policy</span></dd>
                }
            </dl>
        </div>

        @if (!isHeartbeat)
        {
            <div class="hawk-card">
                <div class="font-semibold mb-3">Headers</div>
                @if (Model.Monitor.Headers.Count == 0)
                {
                    <div class="text-sm text-[color:var(--text-secondary)]">None.</div>
                }
                else
                {
                    <ul class="space-y-3 text-xs font-mono">
                        @foreach (var h in Model.Monitor.Headers)
                        {
                            <li class="py-1"><span class="text-[color:var(--text-secondary)]">@h.Name</span>: <span>@h.Value</span></li>
                        }
                    </ul>
                }
            </div>

            <div class="hawk-card">
                <div class="font-semibold mb-3">Match rules</div>
                @if (Model.Monitor.MatchRules.Count == 0)
                {
                    <div class="text-sm text-[color:var(--text-secondary)]">None.</div>
                }
                else
                {
                    <ul class="space-y-3 text-xs font-mono">
                        @foreach (var r in Model.Monitor.MatchRules)
                        {
                            <li class="py-1"><span class="text-[color:var(--text-secondary)]">@r.Mode</span>: <span>@r.Pattern</span></li>
                        }
                    </ul>
                }
            </div>
        }
    </div>

    <div class="lg:col-span-7">
        <div class="hawk-card p-0 overflow-hidden">
            <div class="px-4 py-4 border-b border-[color:var(--border-primary)]">
                <div class="font-semibold">Recent runs</div>
            </div>
            @if (Model.Runs.Count == 0)
            {
                <div class="px-4 py-6 text-sm text-[color:var(--text-secondary)]">No runs yet.</div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full text-xs">
                        <thead class="hawk-runs-thead bg-[color:var(--bg-secondary)] text-[color:var(--text-secondary)]">
                        <tr>
                            <th class="text-left font-semibold px-4">When</th>
                            @if (!isHeartbeat)
                            {
                                <th class="text-left font-semibold px-4">Duration</th>
                            }
                            <th class="text-left font-semibold px-4">Result</th>
                        </tr>
                        </thead>
                        <tbody class="hawk-runs-tbody">
                        @foreach (var r in Model.Runs)
                        {
                            var runState = string.IsNullOrWhiteSpace(r.State) ? "completed" : r.State;
                            <tr class="hover:bg-[color:var(--bg-secondary)] cursor-pointer"
                                role="link"
                                tabindex="0"
                                onclick="window.location.href='@Url.Page("/Monitors/Runs/Details", new { monitorId = Model.Monitor.Id, runId = r.Id })'"
                                onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); window.location.href='@Url.Page("/Monitors/Runs/Details", new { monitorId = Model.Monitor.Id, runId = r.Id })'; }">
                                <td class="px-4">
                                    <a class="underline decoration-dotted underline-offset-2 hover:no-underline"
                                       asp-page="/Monitors/Runs/Details"
                                       asp-route-monitorId="@Model.Monitor.Id"
                                       asp-route-runId="@r.Id">
                                        <time data-utc="@r.StartedAt.ToString("O")" data-utc-format="short">@UtcFallback(r.StartedAt)</time>
                                    </a>
                                </td>
                                @if (!isHeartbeat)
                                {
                                    <td class="px-4 text-[color:var(--text-secondary)]">@r.DurationMs ms</td>
                                }
                                <td class="px-4">
                                    @if (!string.Equals(runState, "completed", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="hawk-badge hawk-badge-warning">@runState.ToUpperInvariant()</span>
                                    }
                                    else if (r.Success)
                                    {
                                        <span class="hawk-badge hawk-badge-success">OK</span>
                                    }
                                    else
                                    {
                                        <span class="hawk-badge hawk-badge-danger">FAIL</span>
                                        <span class="reason ml-2">@((r.ErrorMessage ?? "-").Length > 120 ? (r.ErrorMessage![..120] + "...") : (r.ErrorMessage ?? "-"))</span>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
